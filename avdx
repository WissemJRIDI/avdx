#!/usr/bin/env bash
# avdx - interactive launcher for Android Virtual Devices (AVDs)
# Works on macOS (bash 3.2+) and Linux. No dependencies beyond the Android SDK.
set -u

VERSION="1.0.0"
PROG="avdx"

COLD=0
WIPE=0
HEADLESS=0
FOREGROUND=0
EXTRA=()
POS=()
AVDS=()
RUNNING=""
CUR=0

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
$PROG $VERSION - launch Android emulators from the terminal

Usage:
  $PROG                     Interactive menu (arrow keys / j k, enter to launch)
  $PROG list                List AVDs (running ones are marked)
  $PROG run <name> [opts]   Launch a specific AVD
  $PROG stop [name]         Stop one running emulator, or all if no name given

Options:
  -c, --cold        Cold boot (ignore saved snapshot)
  -w, --wipe        Wipe user data (factory reset)
  -H, --headless    No emulator window (useful for CI)
  -f, --foreground  Keep the emulator attached to this terminal
  -h, --help        Show this help
  -v, --version     Show version
  -- <args...>      Pass remaining arguments straight to the emulator

Menu keys:
  up/down or k/j    Move        enter  Launch
  c / w / h         Toggle cold boot / wipe data / headless
  q                 Quit

Environment:
  ANDROID_HOME or ANDROID_SDK_ROOT is used to locate the SDK if the
  'emulator' and 'adb' binaries are not already on your PATH.
EOF
}

# ---------------------------------------------------------------- SDK lookup

find_tool() { # find_tool <binary> <subdir inside SDK>
  local name=$1 sub=$2 root
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for root in \
    "${ANDROID_HOME:-}" \
    "${ANDROID_SDK_ROOT:-}" \
    "$HOME/Library/Android/sdk" \
    "$HOME/Android/Sdk" \
    "/opt/homebrew/share/android-commandlinetools" \
    "/usr/local/share/android-commandlinetools"; do
    if [[ -n $root && -x $root/$sub/$name ]]; then
      echo "$root/$sub/$name"
      return 0
    fi
  done
  return 1
}

load_avds() {
  AVDS=()
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && AVDS+=("$line")
  done < <("$EMULATOR" -list-avds 2>/dev/null | grep -v '^INFO' | tr -d '\r')
}

# Prints "<serial> <avd name>" for each running emulator
running_map() {
  [[ -n $ADB ]] || return 0
  local serial state name
  while read -r serial state; do
    [[ $serial == emulator-* && $state == device ]] || continue
    name=$("$ADB" -s "$serial" emu avd name 2>/dev/null | head -n1 | tr -d '\r')
    [[ -n $name ]] && echo "$serial $name"
  done < <("$ADB" devices 2>/dev/null | tail -n +2)
}

is_running() {
  printf '%s\n' "$RUNNING" | awk -v n="$1" '$2==n{f=1} END{exit !f}'
}

has_avd() {
  local a
  for a in ${AVDS[@]+"${AVDS[@]}"}; do
    [[ $a == "$1" ]] && return 0
  done
  return 1
}

# ------------------------------------------------------------------- launch

launch() {
  local name=$1 log pid
  local args=(-avd "$name")
  (( COLD ))     && args+=(-no-snapshot-load)
  (( WIPE ))     && args+=(-wipe-data)
  (( HEADLESS )) && args+=(-no-window)
  args+=(${EXTRA[@]+"${EXTRA[@]}"})

  if (( FOREGROUND )); then
    exec "$EMULATOR" "${args[@]}"
  fi

  log="${TMPDIR:-/tmp}/avdx-${name}.log"
  printf 'Starting %s ...\n' "$name"
  nohup "$EMULATOR" "${args[@]}" >"$log" 2>&1 &
  pid=$!
  disown "$pid" 2>/dev/null || true
  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    printf 'Launched %s (pid %s). Log: %s\n' "$name" "$pid" "$log"
  else
    printf 'Emulator exited immediately. Last log lines:\n' >&2
    tail -n 15 "$log" >&2
    return 1
  fi
}

# --------------------------------------------------------------------- menu

draw() {
  local i n=${#AVDS[@]} tag box_c=" " box_w=" " box_h=" "
  (( COLD ))     && box_c="x"
  (( WIPE ))     && box_w="x"
  (( HEADLESS )) && box_h="x"

  printf '\033[1m Android Virtual Devices\033[0m\033[K\n'
  printf '\033[2m ↑/↓ move · enter launch · q quit\033[0m\033[K\n'
  for (( i = 0; i < n; i++ )); do
    tag=""
    is_running "${AVDS[$i]}" && tag=$' \033[32m● running\033[0m'
    if (( i == CUR )); then
      printf '\033[7m ▸ %s \033[0m%s\033[K\n' "${AVDS[$i]}" "$tag"
    else
      printf '   %s%s\033[K\n' "${AVDS[$i]}" "$tag"
    fi
  done
  printf '\033[K\n'
  printf ' [%s] (c)old boot   [%s] (w)ipe data   [%s] (h)eadless\033[K\n' "$box_c" "$box_w" "$box_h"
}

menu() {
  local n=${#AVDS[@]} key rest
  (( n > 0 )) || die "no AVDs found. Create one with avdmanager (see README)."

  tput civis 2>/dev/null
  trap 'tput cnorm 2>/dev/null' EXIT
  draw

  while true; do
    IFS= read -rsn1 key </dev/tty || break
    case $key in
      $'\033')
        rest=""
        read -rsn2 -t 1 rest </dev/tty || true
        case $rest in
          '[A') (( CUR > 0 )) && CUR=$((CUR - 1)) ;;
          '[B') (( CUR < n - 1 )) && CUR=$((CUR + 1)) ;;
        esac
        ;;
      k) (( CUR > 0 )) && CUR=$((CUR - 1)) ;;
      j) (( CUR < n - 1 )) && CUR=$((CUR + 1)) ;;
      c) COLD=$((1 - COLD)) ;;
      w) WIPE=$((1 - WIPE)) ;;
      h) HEADLESS=$((1 - HEADLESS)) ;;
      q) tput cnorm 2>/dev/null; echo; return 0 ;;
      '')
        tput cnorm 2>/dev/null
        echo
        if (( WIPE )); then
          printf 'Wipe all data on %s? [y/N] ' "${AVDS[$CUR]}"
          read -r ans </dev/tty
          [[ $ans == [yY]* ]] || { echo "Cancelled."; return 0; }
        fi
        launch "${AVDS[$CUR]}"
        return $?
        ;;
    esac
    printf '\033[%dA' $((n + 4))
    draw
  done
}

# ----------------------------------------------------------------- commands

cmd_list() {
  local a
  (( ${#AVDS[@]} > 0 )) || die "no AVDs found."
  for a in "${AVDS[@]}"; do
    if is_running "$a"; then printf '%s  (running)\n' "$a"; else echo "$a"; fi
  done
}

cmd_run() {
  [[ -n ${1:-} ]] || die "usage: $PROG run <name>"
  has_avd "$1" || { echo "$PROG: unknown AVD '$1'. Available:" >&2; printf '  %s\n' ${AVDS[@]+"${AVDS[@]}"} >&2; exit 1; }
  launch "$1"
}

cmd_stop() {
  [[ -n $ADB ]] || die "adb not found."
  local serial name found=0
  while read -r serial name; do
    [[ -n $serial ]] || continue
    if [[ -z ${1:-} || $name == "$1" ]]; then
      "$ADB" -s "$serial" emu kill >/dev/null 2>&1
      echo "Stopped $name ($serial)"
      found=1
    fi
  done <<< "$RUNNING"
  (( found )) || echo "No matching running emulators."
}

# --------------------------------------------------------------------- main

while (( $# )); do
  case $1 in
    -h|--help)       usage; exit 0 ;;
    -v|--version)    echo "$PROG $VERSION"; exit 0 ;;
    -c|--cold)       COLD=1 ;;
    -w|--wipe)       WIPE=1 ;;
    -H|--headless)   HEADLESS=1 ;;
    -f|--foreground) FOREGROUND=1 ;;
    --)              shift; EXTRA=("$@"); break ;;
    -*)              die "unknown option: $1 (try --help)" ;;
    *)               POS+=("$1") ;;
  esac
  shift
done

CMD=${POS[0]:-menu}
NAME=${POS[1]:-}

EMULATOR=$(find_tool emulator emulator) \
  || die "Android emulator not found. Install the SDK or set ANDROID_HOME."
ADB=$(find_tool adb platform-tools) || ADB=""

load_avds
RUNNING=$(running_map)

case $CMD in
  menu) if [[ -t 0 && -t 1 ]]; then menu; else cmd_list; fi ;;
  list) cmd_list ;;
  run)  cmd_run "$NAME" ;;
  stop) cmd_stop "$NAME" ;;
  *)    die "unknown command: $CMD (try --help)" ;;
esac
